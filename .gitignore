# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# SQLite (migrated to PostgreSQL/Neon)
db/

# Capacitor Android (regenerate with: npx cap add android)
/android/
/android/keystore.properties
*.apk
# ...except the released installer, which is tracked in android-app/ and copied
# into public/download at build time
!android-app/*.apk
# public/download/ is build output, not source
public/download/

# Release signing keystore (never commit)
*.p12
*.jks
*.keystore
